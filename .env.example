# --- Required ---

# Railway Postgres connection string.
# - Local dev (`npm run dev` on your machine): use the PUBLIC url from
#   Railway -> Postgres service -> Connect -> "Postgres Connection URL"
#   (something like postgresql://postgres:<password>@<name>.proxy.rlwy.net:<port>/railway).
# - Deployed on Railway itself: use the PRIVATE/internal url instead
#   (*.railway.internal) -- faster, stays inside Railway's network. Set
#   this as an environment variable on the Railway service, not in this file.
DATABASE_URL=

# Secret used to derive the AES-256-GCM key for everything encrypted at
# rest: saved provider API keys (api_keys table), chat message content,
# and RAG memory chunks (memory_embeddings.content_chunk). Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this after data has been encrypted makes that data
# undecryptable -- treat it like a database password, not something to
# rotate casually.
ENCRYPTION_SECRET=

# --- Not env vars, on purpose ---
#
# There are no ANTHROPIC_API_KEY / OPENAI_API_KEY / etc. entries here.
# Provider API keys (Claude, OpenAI, Gemini, Grok, Kimi) are managed at
# runtime from the app's Settings page, encrypted with ENCRYPTION_SECRET
# and stored in the api_keys table -- not read from the environment. This
# is also true for the OpenAI key RAG indexing/retrieval uses; if it's not
# saved in Settings, RAG silently does nothing rather than failing.
#
# Ollama (local models) needs no key at all and isn't server-side
# configuration -- the browser talks to http://localhost:11434 on the
# user's own machine directly.
